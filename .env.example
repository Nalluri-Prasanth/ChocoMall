# Copy to .env and replace every value. Never commit .env.
# Generate strong secrets with:  openssl rand -base64 48

# --- Databases and brokers (used by docker compose)
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis
RABBIT_USERNAME=chocomall
RABBIT_PASSWORD=change-me-rabbit

# --- Object storage
MINIO_ACCESS_KEY=chocomall-minio
MINIO_SECRET_KEY=change-me-minio-secret

# --- Application secrets
# Base64 HMAC key for signing JWTs (at least 32 bytes). Staff and customer tokens are bound to different audiences.
JWT_SECRET=
# Shared secret that protects the search index endpoints (/search/index/**)
SEARCH_ADMIN_KEY=change-me-search

# --- First super admin (created once, only if no admin exists). Change the password after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Browser origins allowed to call the APIs, comma separated (leave empty if the front end is served from the same origin)
CORS_ORIGINS=
